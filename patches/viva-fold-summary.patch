+
+// foldSummary finds the display-only text for a visible collapsed header.
+func (editor *CodeEditor) foldSummary(line int) (CodeEditorFoldRange, bool) {
+	index := sort.Search(len(editor.folds), func(i int) bool { return editor.folds[i].Header >= line })
+	if index < len(editor.folds) {
+		fold := editor.folds[index]
+		if fold.Header == line && fold.Display != "" && fold.SummaryStart >= 0 && fold.SummaryStart <= len(fold.Display) {
+			return fold, true
+		}
+	}
+	return CodeEditorFoldRange{}, false
+}
